# Copy this file to ".env" and fill it in. Never commit the real .env file.

# Which AI service to use:
#   company-gateway  your company's internal AI gateway (recommended at work)
#   gemini           Google Gemini with a Google AI Studio key
#   azure-openai     Azure OpenAI
# If left empty: company-gateway when GATEWAY_URL is filled in, otherwise gemini.
AI_PROVIDER=company-gateway

# --- Company AI gateway ------------------------------------------------------
# Copy these values from your company's GenAI API guide. They are internal:
# keep them in this .env file only, never in the code or a public repository.
GATEWAY_URL=
GATEWAY_API_KEY=
# Name of the header that carries the key, as written in the guide
GATEWAY_KEY_HEADER=
# Model id from the guide. You can list a backup after a comma: first,second
GATEWAY_MODEL=
# Optional app identifier header from the guide, and a name for this app
GATEWAY_CLIENT_HEADER=
GATEWAY_CLIENT_ID=voice-manual-manuel
# Optional: who usage is booked to. Empty = the owner of the key.
GATEWAY_USER_ID=
# GATEWAY_MAX_TOKENS=1024
# GATEWAY_TIMEOUT_MS=45000

# --- Google Gemini (only if AI_PROVIDER=gemini) ------------------------------
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: always use this one model instead of choosing automatically
# GEMINI_MODEL=gemini-2.5-flash

# --- Azure OpenAI (only if AI_PROVIDER=azure-openai) -------------------------
# AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# Websites allowed to use this server, comma separated.
# Leave empty if the manual is served by this same server (STATIC_DIR below).
ALLOWED_ORIGINS=

# Serve the manual from this folder too (".." = the folder above this one).
STATIC_DIR=..

# Limits per network address. Many technicians in one office may share one address.
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_DAY=1000

PORT=8787
# Set to true if this runs behind IIS, nginx, a load balancer, or similar.
TRUST_PROXY=false
