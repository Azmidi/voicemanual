# Copy this file to ".env" and fill it in. Never commit the real .env file.

# Which AI service to use: gemini (default) or azure-openai
AI_PROVIDER=gemini

# Gemini key from https://aistudio.google.com/apikey (or your company's Google Cloud project)
GEMINI_API_KEY=
# Optional: always use this one model instead of choosing automatically
# GEMINI_MODEL=gemini-2.5-flash

# Only if AI_PROVIDER=azure-openai
# AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# Websites allowed to use this server, comma separated.
# Leave empty if the manual is served by this same server (STATIC_DIR below).
ALLOWED_ORIGINS=

# Serve the manual from this folder too (".." = the folder above this one).
STATIC_DIR=..

# Limits per network address. Many technicians in one office may share one address.
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_DAY=1000

PORT=8787
# Set to true if this runs behind IIS, nginx, a load balancer, or similar.
TRUST_PROXY=false
